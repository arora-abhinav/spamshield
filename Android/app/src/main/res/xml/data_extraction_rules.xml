<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up device_id and user settings so they survive reinstalls -->
        <include domain="sharedpref" path="spamshield_backup_prefs.xml"/>
        <!-- Exclude encrypted prefs — keys are device-specific and cannot be restored -->
        <exclude domain="sharedpref" path="spamshield_secure_prefs.xml"/>
    </cloud-backup>
</data-extraction-rules>
